{
    "name": "anandukrishnakk/laravel-azure-keyvault",
    "description": "Azure Key Vault integration for Laravel 12 using Managed Identity or Service Principal.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anandu Krishna",
            "email": "anandukrishnakk@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "AnanduKrishna\\AzureKeyVault\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnanduKrishna\\AzureKeyVault\\AzureKeyVaultServiceProvider"
            ],
            "aliases": {
                "AzureKeyVault": "AnanduKrishna\\AzureKeyVault\\Facades\\AzureKeyVault"
            }
        }
    }
}